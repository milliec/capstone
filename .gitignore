.venv/
.env
__pycache__/

# Real source material: contains real fund names and company references.
# Never commit. The capstone uses anonymised mock data derived from it instead.
reference/

# Private working docs: kept on disk only, never committed.
# (The Netlify page is dropped in manually, so it does not need to be tracked.)
# "docs/*" (not "docs/") so the two lines starting with "!" below can make exceptions.
# Those two files were made public by the operator on 2026-11-16.
docs/*
!docs/ai-direction-log.md
!docs/learning-notes.md

# The local SQLite database and process log (SAD §5). Delete data/app.db to start from nothing.
data/

# Python packaging leftovers from "pip install -e ."
*.egg-info/
.pytest_cache/
