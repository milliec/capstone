# .env.example: copy to .env (which git ignores) and fill in. NEVER put a real key in this file.
# This repository is public. Only placeholders belong here.

# --- Framework runtime ---
AAMAD_TARGET_RUNTIME=crewai

# --- Agent mode ---
# stand_in = the three agents return fixed outputs, no model call, no cost (default).
# Keep stand_in until the first green path passes AND DL-40 / SOQ-25 is pinned (SAD Build card).
AGENTS_MODE=stand_in

# --- CrewAI's own outside connections: OFF (B3 step 7b) ---
# backend/runtime/crewai_setup.py FORCES these before CrewAI loads, whatever this file says:
# telemetry (both switches), CrewAI's own tracing, and its version check. Listed here so you
# know they exist; changing them here has no effect.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_VERSION_CHECK=true

# --- Model provider (only read when AGENTS_MODE is not stand_in) ---
OPENAI_API_KEY=sk-REPLACE-ME-placeholder-not-a-real-key

# --- Spend control ---
# Hard stop per run, in US dollars.
RUN_COST_CAP_USD=2.50
# Which of the five real-call activities is being paid for (spike, tuning, evaluation,
# rehearsal, demo). Leave empty in stand_in mode. Exact accepted values: confirm in SAD.
SPEND_ACTIVITY=

# --- Per-call timeouts, seconds (SAD Build card: extract 90, verify 60, judge 60) ---
# The HTTP client timeout sits a few seconds BELOW the call timeout.
CALL_TIMEOUT_EXTRACT_S=90
CALL_TIMEOUT_VERIFY_S=60
CALL_TIMEOUT_JUDGE_S=60
HTTP_TIMEOUT_EXTRACT_S=85
HTTP_TIMEOUT_VERIFY_S=55
HTTP_TIMEOUT_JUDGE_S=55

# --- Stage limits, seconds, enforced on the backend's own timer (not max_execution_time) ---
# Names as in SAD §4 "Sign-in and secrets" (B3 step 6; were STAGE_LIMIT_*_S).
STAGE_TIME_LIMIT_A=375
STAGE_TIME_LIMIT_B=150
STAGE_TIME_LIMIT_C=30

# --- Stand-in pause (B13a, DL-54) ---
# Seconds each stand-in agent function waits per unit, so the units table fills in one row at a
# time. Read ONLY when AGENTS_MODE=stand_in; never read in real mode. Tests set it to 0.
STAND_IN_UNIT_PAUSE_S=1

# --- Sign-in and storage (SAD §4 "Sign-in and secrets") ---
# Signs the session cookie that holds the mock identity. Use any long random local value, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE-ME-with-a-local-random-value
# Where the SQLite file lives. Created on first start.
DATABASE_PATH=data/app.db
