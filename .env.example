# .env.example: copy to .env (which git ignores) and fill in. NEVER put a real key in this file.
# This repository is public. Only placeholders belong here.

# --- Framework runtime ---
AAMAD_TARGET_RUNTIME=crewai

# --- Agent mode ---
# stand_in = the three agents return fixed outputs, no model call, no cost (default).
# Keep stand_in until the first green path passes AND DL-40 / SOQ-25 is pinned (SAD Build card).
AGENTS_MODE=stand_in

# --- Model provider (only read when AGENTS_MODE is not stand_in) ---
OPENAI_API_KEY=sk-REPLACE-ME-placeholder-not-a-real-key

# --- Spend control ---
# Hard stop per run, in US dollars.
RUN_COST_CAP_USD=2.50
# Which of the five real-call activities is being paid for (spike, tuning, evaluation,
# rehearsal, demo). Leave empty in stand_in mode. Exact accepted values: confirm in SAD.
SPEND_ACTIVITY=

# --- Per-call timeouts, seconds (SAD Build card: extract 90, verify 60, judge 60) ---
# The HTTP client timeout sits a few seconds BELOW the call timeout.
CALL_TIMEOUT_EXTRACT_S=90
CALL_TIMEOUT_VERIFY_S=60
CALL_TIMEOUT_JUDGE_S=60
HTTP_TIMEOUT_EXTRACT_S=85
HTTP_TIMEOUT_VERIFY_S=55
HTTP_TIMEOUT_JUDGE_S=55

# --- Stage limits, seconds, enforced on the backend's own timer (not max_execution_time) ---
STAGE_LIMIT_A_S=375
STAGE_LIMIT_B_S=150
STAGE_LIMIT_C_S=30
